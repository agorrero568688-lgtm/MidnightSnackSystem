{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/images/(.*)", "destination": { "service": "app" } },
    { "source": "/build/(.*)", "destination": { "service": "app" } },
    { "source": "/favicon.ico", "destination": { "service": "app" } },
    { "source": "/favicon.svg", "destination": { "service": "app" } },
    { "source": "/favicon.png", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/cron/abandoned-reminders", "schedule": "0 16 * * *" }
  ]
}
