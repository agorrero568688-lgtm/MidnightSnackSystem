:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    php_server {
        try_files {path} index.php
    }

    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @menuImages path /images/*
    header @menuImages Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
}
