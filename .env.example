APP_NAME="Diding's Midnight Snack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Store-local so daily reports and shift cut-offs fall on Philippine days.
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Production / staging: Supabase Postgres (session pooler, port 5432).
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# Local development against SQLite is much faster than a remote database.
# Uncomment this block and comment the pgsql block above to use it:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- Session / cache ------------------------------------------------------
# Local dev uses files. On Vercel set SESSION_DRIVER=database and
# CACHE_STORE=database so state is shared across container instances.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# On Vercel use QUEUE_CONNECTION=sync (jobs run during the request).
QUEUE_CONNECTION=database

# Public product photos and the GCash QR are written to the "public" disk.
# Run `php artisan storage:link` once so /storage/... is reachable.
# On Vercel both disks switch to Supabase Storage via the drivers below.

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage (Supabase S3) -------------------------------------------------
# Locally both stay "local". On Vercel set both to "s3".
PROOF_DISK_DRIVER=local
PUBLIC_DISK_DRIVER=local
# Livewire temporary uploads use the private disk so previews are signed URLs.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage S3 settings (used when the disk drivers are "s3").
# AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_PROOFS_BUCKET=proofs
# AWS_MEDIA_BUCKET=media
# AWS_MEDIA_URL=https://<project-ref>.storage.supabase.co/storage/v1/object/public/media

# --- Scheduled jobs --------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Online ordering alerts ------------------------------------------------
# Optional. The values can also be set from Settings in the back office.
# Create a bot with @BotFather, add it to the private staff group, then use the
# negative group chat ID. Alerts are queued, so run `php artisan queue:work`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
