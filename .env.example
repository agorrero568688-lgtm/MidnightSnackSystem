APP_NAME="Diding's Midnight Snack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Store-local so daily reports and shift cut-offs fall on Philippine days.
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Production / staging: Supabase Postgres (session pooler, port 5432).
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# Local development against SQLite is much faster than a remote database.
# Uncomment this block and comment the pgsql block above to use it:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- Session / cache ------------------------------------------------------
# Local dev uses files. On Vercel set SESSION_DRIVER=database and
# CACHE_STORE=database so state is shared across container instances.
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# On Vercel keep the cookie host-only: never use a shared suffix like .vercel.app.
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# On Vercel use QUEUE_CONNECTION=sync (jobs run during the request).
QUEUE_CONNECTION=database

# Public product photos and the GCash QR use the media storage below.
# Run `php artisan storage:link` once for local development so /storage/... is
# reachable. On Vercel both final uploads switch to Vercel Blob.

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage ---------------------------------------------------------------
# Local development and tests use Laravel disks. On Vercel set both drivers
# to "blob" so final uploads go straight to Vercel Blob.
MEDIA_DRIVER=local
PROOF_DRIVER=local
# Livewire temporary uploads stay on the local disk; only final files go to Blob.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Create two Blob stores: Images (public) and Receipts (private). Their
# read-write tokens are static, so no OIDC refresh is needed on Vercel.
# The store ID is derived from each token; set the store ID/base URL only if
# you want to override that derivation.
BLOB_PUBLIC_TOKEN=
BLOB_PRIVATE_TOKEN=
# Vercel-generated read-write token env vars are used as fallbacks when the
# custom names above are empty (e.g. a custom env var prefix).
# BLOB_PUBLIC_READ_WRITE_TOKEN=
# BLOB_PRIVATE_READ_WRITE_TOKEN=
# BLOB_PUBLIC_STORE_ID=
# BLOB_PRIVATE_STORE_ID=
# BLOB_PUBLIC_BASE_URL=https://<store-id>.public.blob.vercel-storage.com
# BLOB_PRIVATE_BASE_URL=https://<store-id>.private.blob.vercel-storage.com

# Existing Supabase public URLs remain readable until media is re-uploaded.
# Legacy receipts are read through the Supabase REST API (never S3).
# LEGACY_MEDIA_URL=https://<project-ref>.storage.supabase.co/storage/v1/object/public/products
# LEGACY_SUPABASE_URL=https://<project-ref>.supabase.co
# LEGACY_SUPABASE_SERVICE_ROLE_KEY=
# LEGACY_PROOFS_BUCKET=proofs

# Legacy S3 variables are no longer used for new uploads. Keep AWS_MEDIA_URL
# only while legacy relative paths still need a public fallback.
# AWS_MEDIA_URL=

# --- Scheduled jobs --------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Online ordering alerts ------------------------------------------------
# Admin SMS alerts use the SMS gateway settings configured in Settings.
# Alerts are queued, so run `php artisan queue:work` in production.

VITE_APP_NAME="${APP_NAME}"
